{
  "manifest_version": 2,
  "id": "zeyr.mai-calendar",
  "version": "0.1.0",
  "name": "今天是什么日子",
  "description": "节日、倒计时与待办提醒",
  "author": {
    "name": "zeyr",
    "url": "https://github.com/zeyr"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/zeyr/mai-calendar"
  },
  "host_application": {
    "min_version": "1.4.8",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.23.0",
    "max_version": "2.23.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "chinese-calendar",
      "version_spec": "<2,>=1.11"
    }
  ],
  "capabilities": [
    "api.get",
    "api.call",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "changelog": "CHANGELOG.md",
  "plugin_type": "chat"
}
